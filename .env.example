# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === Server Configuration ===
NODE_ENV=production
PORT=8080

# === JWT Authentication ===
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY=24h

# === Session Service ===
SESSION_PORT=3000

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://user:password@localhost:5432/pgp_db

# === Redis ===
REDIS_URL=redis://localhost:6379

# === CORS ===
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com

# === Signaling Server ===
SIGNALING_PORT=8080

# === Browser Client ===
VITE_SIGNALING_URL=ws://localhost:8080
VITE_SESSION_URL=http://localhost:3000

# === Mobile Client ===
# These are embedded in app.json for Expo builds
EXPO_PUBLIC_SIGNALING_URL=ws://your-server.com:8080
EXPO_PUBLIC_SESSION_URL=https://your-server.com:3000
